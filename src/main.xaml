<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark" Padding="16" RowSpacing="10">
 <Grid.Background>
  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9A183B57" Offset="0"/><GradientStop Color="#70203349" Offset="0.55"/><GradientStop Color="#96204C51" Offset="1"/></LinearGradientBrush>
 </Grid.Background>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="窗口管理" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button x:Name="Refresh" Content="刷新"/><Button x:Name="UnlockAll" Content="全部解锁"/></StackPanel></Grid>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="10">
   <TextBox x:Name="Search" PlaceholderText="搜索窗口标题或进程…" AutomationProperties.Name="搜索窗口"/>
   <StackPanel x:Name="TopActions" Spacing="8">
    <ComboBox x:Name="Target" Header="转移到" MinWidth="180" HorizontalAlignment="Stretch"/>
    <Button x:Name="Move" Content="转移勾选窗口" Style="{StaticResource AccentButtonStyle}" Background="#9AEBDC" Foreground="#10383C" VerticalAlignment="Bottom"/>
    <ComboBox x:Name="Sort" Header="排序" MinWidth="140" SelectedIndex="0"><ComboBoxItem Content="按进程"/><ComboBoxItem Content="按标题"/><ComboBoxItem Content="按显示器"/><ComboBoxItem Content="按状态"/></ComboBox>
   </StackPanel>
   <StackPanel x:Name="SelectionActions" Spacing="8"><Button x:Name="SelectAll" Content="全选（排除黑名单）"/><Button x:Name="Clear" Content="清除勾选"/><TextBlock x:Name="Count" Text="正在读取窗口…" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
   <StackPanel x:Name="WindowActions" Spacing="8"><Button x:Name="Lock" Content="锁定勾选"/><Button x:Name="Unlock" Content="解锁勾选"/><Button x:Name="Restore" Content="解除最小化"/><Button x:Name="Cancel" Content="取消勾选任务"/></StackPanel>
   <Border CornerRadius="12" BorderThickness="1" BorderBrush="#526BA4BD" Background="#8A0D273B" Padding="10">
    <StackPanel Spacing="8"><TextBlock Text="窗口 / 显示器 / 状态" Foreground="#BCE5ED" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <ScrollViewer x:Name="WindowScroll" MaxHeight="430" MinHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Rows" Spacing="4"/></ScrollViewer>
     <TextBlock x:Name="Empty" Text="未发现符合筛选条件的窗口" Opacity="0.65" Visibility="Collapsed"/>
    </StackPanel>
   </Border>

   <Expander Header="鼠标范围与规则设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="12">
     <StackPanel x:Name="SettingsActions" Spacing="8"><ComboBox x:Name="MouseTarget" Header="鼠标锁定范围（包含任务栏）" MinWidth="230"/><Button x:Name="MouseApply" Content="锁定鼠标" VerticalAlignment="Bottom"/><Button x:Name="MouseRelease" Content="解除鼠标锁定" VerticalAlignment="Bottom"/></StackPanel>
     <TextBlock x:Name="MouseStatus" Text="鼠标：未锁定" TextWrapping="Wrap"/>
     <TextBlock Text="Ctrl+Alt+←/→ 转移；L 锁定；U 解锁；M 切换鼠标锁定；Shift+M 紧急解除（均需 Ctrl+Alt）。" TextWrapping="Wrap" Opacity="0.7"/>
     <TextBlock x:Name="BlacklistRules" Text="暂无黑名单规则" TextWrapping="Wrap"/>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Blacklist" Header="黑名单：进程名或标题关键字" PlaceholderText="例如 mpv.exe"/><Button x:Name="BlacklistAdd" Grid.Column="1" Content="添加" VerticalAlignment="Bottom"/><Button x:Name="BlacklistRemove" Grid.Column="2" Content="移除" VerticalAlignment="Bottom"/></Grid>
     <CheckBox x:Name="Autostart" Content="登录 Windows 后自动启动 Rust 版"/>
    </StackPanel>
   </Expander>
  </StackPanel>
 </ScrollViewer>
 <Border Grid.Row="2" Padding="10,7" CornerRadius="8" BorderThickness="1" BorderBrush="#426BA4BD" Background="#80162B3E"><TextBlock x:Name="Status" Text="初始化中…" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></Border>
</Grid>
